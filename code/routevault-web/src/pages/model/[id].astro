---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { modelDetail, logInterest } from '../../lib/db.js';

const { id } = Astro.params;
let data = null;
try { data = await modelDetail(id); } catch (e) { console.error(e.message); }
if (!data) {
  return new Response('Not found', { status: 404, headers: { 'content-type': 'text/plain' } });
}
const { model: m, price_history: hist, benchmarks: benches } = data;
const bench = Object.fromEntries(benches.map((b) => [b.benchmark_type, b.score]));
void logInterest('page_view', m.model_id, { path: `/model/${m.model_id}` });
const desc = m.description || `${m.model_id} — live OpenRouter pricing, benchmark scores and price history on RouteVault.`;
---
<Base title={`${m.model_id} — ${m.rv_label} • RouteVault`} description={desc} ogImage={`https://routevault.ai/og/${m.model_id}.png`}>
  <Nav active="/models" />
  <main class="rv-wrap">
    <p class="kicker">{m.provider} · {m.openrouter_id}</p>
    <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:flex-end">
      <div>
        <h1 style="font-size:clamp(1.6rem,4vw,2.6rem)">{m.display_name || m.model_id}</h1>
        <div class="dim mono" style="font-size:.85rem;margin:.2rem 0 .4rem">{m.model_id}</div>
        <span class="pill hot">{m.rv_label}</span>
        <span class="pill">{m.context_k}k context</span>
        {m.hermes_fit && <span class="pill">Hermes {m.hermes_fit}</span>}
      </div>
      <div style="display:flex;gap:.45rem">
        <a class="rv-ghost" href={`/route?current=${m.model_id}`}>Route cheaper</a>
      </div>
    </div>
    <p class="lede" style="margin-top:1rem">{m.description || 'No provider blurb.'}</p>

    <div class="grid-3" style="margin:1.4rem 0">
      {[
        ['Input / M', `$${m.input_price?.toFixed(3)}`],
        ['Output / M', `$${m.output_price?.toFixed(3)}`],
        ['Value score', m.value_score ?? '—'],
        ['30d price Δ', m.price_change_30d != null ? m.price_change_30d + '%' : '—'],
        ['Reasoning (AA)', bench.reasoning ?? '—'],
        ['Coding (AA)', bench.coding ?? '—'],
        ['Tool / agentic', bench.tool_use ?? '—'],
        ['Knowledge cutoff', m.knowledge_cutoff || '—'],
      ].map(([k, v]) => (
        <div class="card" style="padding:.9rem 1rem">
          <div class="dim" style="font-size:.72rem">{k}</div>
          <div class="num" style="font-size:1.1rem">{v}</div>
        </div>
      ))}
    </div>

    <section style="margin-top:1.6rem">
      <h2>Price history</h2>
      {hist.length >= 2 ? (
      <div class="card" style="padding:1.2rem;overflow:auto">
        <svg viewBox={`0 0 900 180`} width="100%" height="180" preserveAspectRatio="none">
          <polyline
            points={hist.map((p, i) => {
              const prices = hist.map((x) => Number(x.input_price) + Number(x.output_price));
              const min = Math.min(...prices), max = Math.max(...prices), span = (max - min) || 1;
              const x = (i / (hist.length - 1)) * 900;
              const y = 170 - ((Number(p.input_price) + Number(p.output_price)) - min) / span * 150;
              return `${x.toFixed(1)},${y.toFixed(1)}`;
            }).join(' ')}
            fill="none" stroke="var(--accent)" stroke-width="2.5" />
        </svg>
        <p class="dim" style="font-size:.78rem">Blended in+out list price, weekly (OpenRouterList) plus live snapshots. {hist.length} points.</p>
      </div>
      ) : <p class="muted">Not enough history yet — newer than the backfill window.</p>}
    </section>

    <section style="margin-top:1.6rem">
      <h2>Capability snapshot</h2>
      <p class="muted">Last-known Artificial Analysis indexes via OpenRouter.</p>
      <table class="explorer" style="max-width:480px">
        <thead><tr><th>Index</th><th>Score</th></tr></thead>
        <tbody>
          {benches.map((b) => (
            <tr><td>{b.benchmark_type}</td><td class="num">{Number(b.score).toFixed(1)}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  </main>
</Base>
