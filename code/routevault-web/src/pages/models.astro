---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { allModels } from '../lib/db.js';
let models = [];
try { models = await allModels(); } catch (e) { console.error(e.message); }
---
<Base title="Model Explorer • RouteVault" description="Compare live AI model prices against capability across the full catalog.">
  <Nav active="/models" />
  <script is:inline src="/legacy.js"></script>
  <main class="rv-wrap">
    <p class="kicker">Explorer</p>
    <h1>Models explorer</h1>
    <p class="lede">{models.length} models. Server-rendered every request from the live catalog.</p>
    <div class="card" style="margin-top:1.2rem" id="cost-est">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap">
        <strong>Estimate your monthly cost</strong>
        <span class="dim" id="ce-blend" style="font-size:.78rem"></span>
      </div>
      <p class="muted" style="font-size:.82rem;margin:.3rem 0 .6rem">Set your typical usage — the estimator shows a blended $/M and an Est. $/mo column, sorted cheapest first. Prices are per million tokens.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center">
        <label class="dim" style="font-size:.78rem">Tokens in (M/mo) <input id="ce-in" type="number" min="0" step="any" placeholder="10" style="width:6rem;background:var(--bg-2);color:var(--ink);border:1px solid var(--line);border-radius:4px;padding:.35rem"></label>
        <label class="dim" style="font-size:.78rem">Tokens out (M/mo) <input id="ce-out" type="number" min="0" step="any" placeholder="2" style="width:6rem;background:var(--bg-2);color:var(--ink);border:1px solid var(--line);border-radius:4px;padding:.35rem"></label>
        <div style="flex:1;min-width:240px">
          <div style="position:relative;height:2rem">
            <div id="ce-track" style="position:absolute;top:.9rem;left:0;right:0;height:.25rem;background:var(--bg-2);border-radius:.25rem"></div>
            <div id="ce-fill" style="position:absolute;top:.9rem;left:0;right:0;height:.25rem;background:var(--accent,#4A90D9);border-radius:.25rem"></div>
            <input id="ce-bmin" type="range" min="0" max="1000" value="0" step="1" onpointerdown="this.style.pointerEvents='auto';this.nextElementSibling.style.pointerEvents='none'" style="position:absolute;top:.45rem;left:0;width:100%;appearance:none;-webkit-appearance:none;background:transparent;pointer-events:none;height:1.2rem;margin:0">
            <input id="ce-bmax" type="range" min="0" max="1000" value="1000" step="1" onpointerdown="this.style.pointerEvents='auto';this.previousElementSibling.style.pointerEvents='none'" onpointerup="this.style.pointerEvents='none';this.previousElementSibling.style.pointerEvents='auto'" style="position:absolute;top:.45rem;left:0;width:100%;appearance:none;-webkit-appearance:none;background:transparent;pointer-events:none;height:1.2rem;margin:0">
          </div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:.2rem">
            <span class="mono" style="font-size:.85rem" id="ce-labmin">any</span>
            <span style="font-size:.82rem;opacity:.85" id="ce-labhint">monthly budget — drag both ends</span>
            <span class="mono" style="font-size:.85rem" id="ce-labmax">any</span>
          </div>
        </div>
        <button type="button" id="ce-apply" class="rv-cta">Apply</button>
        <button type="button" id="ce-clear" class="rv-ghost" style="display:none">Clear</button>
      </div>
    </div>
    <div class="card" style="margin-top:.8rem" id="rv-filters">
      <label>Provider <select id="f-provider"><option value="">All</option></select></label>
      <label>Label <select id="f-label"><option value="">All</option></select></label>
      <label>Context <select id="f-ctx">
        <option value="">Any</option>
        <option value="200">&ge; 200k</option>
        <option value="100">&ge; 100k</option>
        <option value="32">&ge; 32k</option>
      </select></label>
      <label>Price <select id="f-price">
        <option value="">Any</option>
        <option value="1">In &le; $1/M</option>
        <option value="3">In &le; $3/M</option>
        <option value="10">In &le; $10/M</option>
      </select></label>
      <label><input type="checkbox" id="f-movers"> Movers only (|30d Δ| &ge; 1%)</label>
      <label><input type="checkbox" id="f-scored"> Benchmarked only</label>
      <input type="search" id="f-search" placeholder="Search model…" style="flex:1;min-width:140px">
      <button type="button" id="f-reset" class="rv-ghost">Reset</button>
    </div>
    <div class="card" style="margin-top:.8rem;overflow:auto">
      <div class="table-wrap">
      <table class="explorer" id="rv-table" data-rows={JSON.stringify(models.map(m => ({id:m.model_id,name:m.display_name,provider:m.provider,ctx:m.context_k,fit:m.hermes_fit,label:m.rv_label,inP:m.input_price,outP:m.output_price,d30:m.price_change_30d,reason:m.reasoning ?? null,code:m.coding ?? null,value:m.value_score})))}>
        <thead><tr>
          <th data-k="id" class="sortable">Model</th>
          <th data-k="label" class="sortable">Label</th>
          <th data-k="inP" data-num="1" class="sortable num">In / Out per M</th>
          <th data-k="d30" data-num="1" class="sortable num">30d Δ</th>
          <th data-k="reason" data-num="1" class="sortable num">Reason</th>
          <th data-k="code" data-num="1" class="sortable num">Code</th>
          <th data-k="value" data-num="1" class="sortable num">Value</th>
          <th id="th-mo" data-k="mo" data-num="1" class="sortable num" style="display:none">Est. $/mo</th>
          <th></th>
        </tr></thead>
        <tbody></tbody>
      </table>
      </div>
    </div>
  </main>
</Base>
<script>
  const rows = JSON.parse(document.getElementById('rv-table').dataset.rows);
  const tbody = document.querySelector('#rv-table tbody');
  let sortKey = 'id', sortDir = 1;
  const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  // populate provider/label filter options from data
  for (const [sel, key] of [['f-provider','provider'], ['f-label','label']]) {
    const el = document.getElementById(sel);
    [...new Set(rows.map(r => r[key]).filter(Boolean))].sort().forEach(v => {
      const o = document.createElement('option'); o.value = v; o.textContent = v; el.appendChild(o);
    });
  }
  const fmt = n => n == null ? '—' : '$' + n.toFixed(2);
  // Monthly-cost estimator (same picker as /route: dual-thumb quadratic $/M slider, $0–$750)
  const CE_BMAX = 750, ceT2p = t => CE_BMAX * Math.pow(t / 1000, 2);
  let calc = null; // { inM, outM, bmin, bmax } — bmin/bmax are blended $/M bounds or null
  const ceFmt = v => v >= 100 ? '$' + Math.round(v) : v >= 1 ? '$' + v.toFixed(2).replace(/\.?0+$/, '') : '$' + v.toFixed(2);
  const blend = m => {
    if (calc == null || m.inP == null || m.outP == null) return null;
    const { inM, outM } = calc, tot = inM + outM;
    return tot > 0 ? (m.inP * inM + m.outP * outM) / tot : null;
  };
  const monthly = m => (calc && m.inP != null && m.outP != null)
    ? m.inP * calc.inM + m.outP * calc.outM : null;
  const ceRefresh = () => {
    const lo = +document.getElementById('ce-bmin').value, hi = +document.getElementById('ce-bmax').value;
    document.getElementById('ce-labmin').textContent = lo <= 0 ? 'any' : ceFmt(ceT2p(lo));
    document.getElementById('ce-labmax').textContent = hi >= 1000 ? 'any' : ceFmt(ceT2p(hi));
    document.getElementById('ce-labhint').textContent =
      (lo <= 0 && hi >= 1000) ? 'monthly budget — drag both ends' : 'monthly budget';
    document.getElementById('ce-fill').style.left = (lo / 10) + '%';
    document.getElementById('ce-fill').style.right = (1000 - hi) / 10 + '%';
    document.getElementById('ce-fill').style.background = (lo <= 0 && hi >= 1000) ? 'var(--bg-2)' : 'var(--accent,#4A90D9)';
  };
  function visible() {
    const p = document.getElementById('f-provider').value,
          l = document.getElementById('f-label').value,
          c = +document.getElementById('f-ctx').value || 0,
          pr = +document.getElementById('f-price').value || 0,
          mv = document.getElementById('f-movers').checked,
          sc = document.getElementById('f-scored').checked,
          q = document.getElementById('f-search').value.toLowerCase();
    return rows.filter(r => {
      if (!(!p || r.provider === p) || !(!l || r.label === l) ||
          !(!c || (r.ctx || 0) >= c) || !(!pr || (r.inP != null && r.inP <= pr)) ||
          !(!mv || (r.d30 != null && Math.abs(r.d30) >= 1)) || !(!sc || (r.reason != null || r.code != null)) ||
          !(!q || r.id.toLowerCase().includes(q) || r.provider.toLowerCase().includes(q))) return false;
      if (calc && (calc.bmin != null || calc.bmax != null)) {
        const b = blend(r);
        if (b == null) return false;
        if (calc.bmin != null && b < calc.bmin) return false;
        if (calc.bmax != null && b > calc.bmax) return false;
      }
      return true;
    });
  }
  function render() {
    const list = visible().sort((a, b) => {
      let x = a[sortKey], y = b[sortKey];
      if (sortKey === 'mo') { x = monthly(a); y = monthly(b); }
      const nx = x == null, ny = y == null;
      if (nx && ny) return 0; if (nx) return 1; if (ny) return -1;
      return (typeof x === 'number' ? x - y : String(x).localeCompare(String(y))) * sortDir;
    });
    tbody.innerHTML = list.map(m => `<tr>
      <td><div class="mono" style="font-weight:600"><a href="/model/${esc(m.id)}" style="color:inherit;text-decoration:none">${esc(m.name || m.id)}</a></div><div class="dim" style="font-size:.72rem">${esc(m.id)}</div><div class="dim" style="font-size:.75rem">${esc(m.provider)} · ${m.ctx}k · ${esc(m.fit)}</div></td>
      <td><span class="pill">${esc(m.label)}</span></td>
      <td class="num">${fmt(m.inP)} / ${fmt(m.outP)}</td>
      <td class="num">${m.d30 != null ? m.d30.toFixed(1) + '%' : '—'}</td>
      <td class="num">${m.reason ?? '—'}</td>
      <td class="num">${m.code ?? '—'}</td>
      <td class="num">${m.value}</td>
      <td class="num" style="${calc ? '' : 'display:none'}">${calc ? (monthly(m) != null ? ceFmt(monthly(m)) + '/mo' : '—') : ''}</td>
      <td style="white-space:nowrap"><a class="rv-ghost" href="/model/${esc(m.id)}">Open</a> <button type="button" class="rv-ghost" data-stack="${esc(m.id)}">Stack</button></td>
    </tr>`).join('') || '<tr><td colspan="9" class="dim">No models match the current filters.</td></tr>';
    tbody.querySelectorAll('button[data-stack]').forEach(btn =>
      btn.addEventListener('click', () => addToStack(btn.dataset.stack)));
    document.getElementById('th-mo').style.display = calc ? '' : 'none';
    document.querySelectorAll('#rv-table th.sortable').forEach(th => {
      th.classList.toggle('sorted-asc', th.dataset.k === sortKey && sortDir === 1);
      th.classList.toggle('sorted-desc', th.dataset.k === sortKey && sortDir === -1);
    });
  }
  document.querySelectorAll('#rv-table th.sortable').forEach(th => th.addEventListener('click', () => {
    const k = th.dataset.k;
    sortDir = (k === sortKey) ? -sortDir : (th.dataset.num ? -1 : 1);
    sortKey = k; render();
  }));
  document.querySelectorAll('#rv-filters select, #rv-filters input').forEach(el => el.addEventListener('change', render));
  document.getElementById('f-search').addEventListener('input', render);
  document.getElementById('f-reset').addEventListener('click', () => {
    document.querySelectorAll('#rv-filters select').forEach(s => s.value = '');
    document.querySelectorAll('#rv-filters input[type=checkbox]').forEach(c => c.checked = false);
    document.getElementById('f-search').value = '';
    render();
  });
  // Estimator wiring
  document.getElementById('ce-apply').addEventListener('click', () => {
    const inM = parseFloat(document.getElementById('ce-in').value) || 0,
          outM = parseFloat(document.getElementById('ce-out').value) || 0,
          lo = +document.getElementById('ce-bmin').value, hi = +document.getElementById('ce-bmax').value,
          hasBudget = lo > 0 || hi < 1000;
    calc = (inM > 0 || outM > 0 || hasBudget)
      ? { inM, outM, bmin: hasBudget && lo > 0 ? ceT2p(lo) : null, bmax: hasBudget && hi < 1000 ? ceT2p(hi) : null } : null;
    if (calc && (inM > 0 || outM > 0)) {
      document.getElementById('ce-blend').textContent =
        `Your mix: ${inM}M in / ${outM}M out — sorted by Est. $/mo`;
    } else if (calc) {
      document.getElementById('ce-blend').textContent = 'Budget filter only — set token volumes for an Est. $/mo';
    } else {
      document.getElementById('ce-blend').textContent = '';
    }
    if (calc && (inM > 0 || outM > 0)) { sortKey = 'mo'; sortDir = 1; }
    document.getElementById('ce-clear').style.display = calc ? '' : 'none';
    render();
  });
  document.getElementById('ce-clear').addEventListener('click', () => {
    calc = null;
    document.getElementById('ce-in').value = ''; document.getElementById('ce-out').value = '';
    document.getElementById('ce-bmin').value = 0; document.getElementById('ce-bmax').value = 1000;
    document.getElementById('ce-blend').textContent = '';
    document.getElementById('ce-clear').style.display = 'none';
    ceRefresh(); render();
  });
  ['ce-bmin', 'ce-bmax'].forEach(id => document.getElementById(id).addEventListener('input', ceRefresh));
  ceRefresh();
  render();
</script>
<style>
  #rv-filters { display:flex; flex-wrap:wrap; gap:.6rem 1rem; align-items:center; }
  #rv-filters label { display:flex; align-items:center; gap:.35rem; font-size:.85rem; }
  th.sortable { cursor:pointer; user-select:none; white-space:nowrap; }
  th.sortable::after { content:'⇅'; opacity:.35; margin-left:.3rem; font-size:.75rem; }
  th.sorted-asc::after { content:'↑'; opacity:1; }
  th.sorted-desc::after { content:'↓'; opacity:1; }
</style>
