---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { allModels, logInterest } from '../lib/db.js';

void logInterest('page_view', null, { path: '/compare' });

const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

let models = [];
try { models = await allModels(); } catch (e) { console.error(e.message); }

let provPrices = [];
let provGen = null;
try {
  const pp = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'data', 'provider-prices.json'), 'utf8'));
  provPrices = pp.rows || [];
  provGen = pp.generated_at || null;
} catch (_) {}

const norm = (s) => String(s || '').toLowerCase()
  .replace(/^.*?\//, '')
  .replace(/[^a-z0-9.]/g, '-')
  .replace(/-+(latest|preview|exp)$/, '')
  .replace(/-+$/, '');

const PROVIDER_LABELS = {
  anthropic: 'Anthropic (direct)', openai: 'OpenAI (direct)', xai: 'xAI / Grok (direct)',
  google: 'Google AI (direct)', 'google-vertex': 'Google Vertex', deepseek: 'DeepSeek (direct)',
  groq: 'Groq', mistral: 'Mistral (direct)', 'ollama-cloud': 'Ollama Cloud', openrouter: 'OpenRouter',
  cohere: 'Cohere', perplexity: 'Perplexity', 'amazon-bedrock': 'AWS Bedrock', azure: 'Azure',
  'together-ai': 'Together AI', 'fireworks-ai': 'Fireworks AI', cerebras: 'Cerebras',
  'nous-portal': 'Nous Portal',
};

const byKey = new Map();
for (const r of provPrices) {
  if (String(r.model_id).endsWith(':batch')) continue;
  const k = norm(r.model_id);
  if (!byKey.has(k)) byKey.set(k, []);
  byKey.get(k).push(r);
}

// build the full comparison payload (client selects from it)
const comparisons = models.map((m) => {
  const matches = byKey.get(norm(m.model_id)) || [];
  const sources = [{
    provider: 'OpenRouter (via RouteVault)',
    input: Number(m.input_price), output: Number(m.output_price),
    ctx: m.context_k, note: 'our tracked list price',
  }];
  const byLabel = new Map();
  for (const r of matches) {
    const label = PROVIDER_LABELS[r.provider] || r.provider;
    const ex = byLabel.get(label);
    if (ex && ex.input_per_m === r.input_per_m && ex.output_per_m === r.output_per_m) {
      ex._alts.push(r.provider);
      continue;
    }
    r._alts = [];
    byLabel.set(label, r);
  }
  for (const r of byLabel.values()) {
    sources.push({
      provider: PROVIDER_LABELS[r.provider] || r.provider,
      input: r.input_per_m, output: r.output_per_m, ctx: r.context_k,
      note: [r.cache_read_per_m != null ? `cache read $${Number(r.cache_read_per_m).toFixed(2)}/M` : '',
             r._alts.length ? `also on ${r._alts.join(', ')}` : ''].filter(Boolean).join(' · '),
    });
  }
  const multi = sources.length >= 2;
  const blends = sources.map((s) => Number(s.input) + Number(s.output));
  return {
    id: m.model_id, name: m.display_name || m.model_id, label: m.rv_label, provider: m.provider,
    sources: multi ? sources : sources.slice(0, 1),
    count: multi ? sources.length : 1,
    cheapest: Math.min(...blends),
    spread: multi ? (Math.max(...blends) - Math.min(...blends)) : 0,
    multi,
  };
});
const multiOnly = comparisons.filter((c) => c.multi).sort((a, b) => b.spread - a.spread);
const single = comparisons.filter((c) => !c.multi);
const payload = JSON.stringify({ multi: multiOnly, single: single.slice(0, 200) }).replace(/</g, '\\u003c');
---
<Base title="Compare prices across routing services · RouteVault" description="The same model, priced by every routing service and direct provider — side by side.">
  <Nav active="/compare" />
  <main class="rv-wrap" style="max-width:none">
    <div class="wrap">
      <p class="kicker">Shop the same model</p>
      <h1>One model, many price tags.</h1>
      <p class="lede">Pick a model on the left — see what everyone charges for it on the right. Same weights, wildly different tags.</p>
      {provGen && <p class="dim" style="font-size:.75rem;margin:-.8rem 0 0">Provider prices from models.dev + Nous Portal · refreshed {esc(provGen.slice(0, 16).replace('T', ' '))} UTC · {provPrices.length} rows · {new Set(provPrices.map((r) => r.provider)).size} providers</p>}
    </div>

    <div class="cmp-split wrap" style="margin-top:1.2rem">
      <aside class="cmp-list card" style="padding:.6rem">
        <input id="cmp-q" type="search" placeholder="Search 223 models…" autocomplete="off"
          style="width:100%;background:var(--bg-2);color:var(--ink);border:1px solid var(--line);border-radius:.55rem;padding:.55rem .7rem;margin-bottom:.5rem" />
        <div id="cmp-items" style="display:grid;gap:.15rem;max-height:70vh;overflow:auto"></div>
      </aside>
      <section class="cmp-detail" id="cmp-detail">
        <div class="card" style="padding:1.4rem;color:var(--muted)">Select a model to see every source's price.</div>
      </section>
    </div>
    <script type="application/json" id="cmp-data" set:html={payload} />
  </main>

  <style>
    .cmp-split { display:grid; grid-template-columns: 300px 1fr; gap:1.2rem; align-items:start; }
    .cmp-item { display:flex; justify-content:space-between; gap:.6rem; align-items:baseline; padding:.5rem .7rem; border-radius:.55rem; cursor:pointer; }
    .cmp-item:hover { background:var(--hover); }
    .cmp-item.sel { background:var(--pillhot-bg); outline:1px solid var(--pillhot-line); }
    .cmp-item .n { font-weight:600; font-size:.88rem; }
    .cmp-item .d { font-size:.72rem; color:var(--dim); font-family:'IBM Plex Mono',monospace; }
    .cmp-item .best { font-family:'IBM Plex Mono',monospace; font-size:.8rem; color:var(--accent); white-space:nowrap; }
    .cmp-item .cnt { font-size:.68rem; color:var(--dim); }
    .cmp-detail table { font-size:.85rem; }
    .cmp-detail td, .cmp-detail th { padding:.55rem .7rem; }
    .cmp-cheap { color:var(--accent); font-weight:700; }
    .cmp-save { display:inline-block; padding:.2rem .6rem; border-radius:999px; background:var(--pillhot-bg); color:var(--accent); font-size:.75rem; font-weight:600; }
    @media(max-width:900px){ .cmp-split{grid-template-columns:1fr} .cmp-list{order:2} }
  </style>

  <script is:inline>
    const DATA = JSON.parse(document.getElementById('cmp-data').textContent);
    const ALL = [...DATA.multi, ...DATA.single];
    const money = (n) => n == null ? '—' : '$' + Number(n).toFixed(Math.abs(Number(n)) < 0.1 ? 3 : 2);
    const esc2 = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    let selected = null;

    const list = document.getElementById('cmp-items');
    const detail = document.getElementById('cmp-detail');
    const q = document.getElementById('cmp-q');

    function renderList() {
      const term = (q.value || '').toLowerCase();
      const items = ALL.filter((c) => !term || c.name.toLowerCase().includes(term) || c.id.toLowerCase().includes(term));
      list.innerHTML = items.slice(0, 250).map((c) => `
        <div class="cmp-item${selected && selected.id === c.id ? ' sel' : ''}" data-id="${esc2(c.id)}">
          <div>
            <div class="n">${esc2(c.name)}</div>
            <div class="d">${esc2(c.id)} · <span class="cnt">${c.count} source${c.count > 1 ? 's' : ''}</span></div>
          </div>
          ${c.multi ? `<span class="best">${money(c.cheapest)}</span>` : `<span class="d">${money(c.sources[0].input + c.sources[0].output)}</span>`}
        </div>`).join('') || '<div class="dim" style="padding:.7rem">No matches.</div>';
    }

    function renderDetail(c) {
      if (!c) { detail.innerHTML = '<div class="card" style="padding:1.4rem;color:var(--muted)">Select a model to see every source price.</div>'; return; }
      const rows = [...c.sources].sort((a, b) => (a.input + a.output) - (b.input + b.output));
      const cheapest = rows[0].input + rows[0].output;
      const dearest = rows[rows.length - 1].input + rows[rows.length - 1].output;
      const save = dearest - cheapest;
      const savePct = dearest > 0 ? Math.round((save / dearest) * 100) : 0;
      detail.innerHTML = `
        <div class="card" style="padding:1.4rem">
          <div style="display:flex;justify-content:space-between;gap:1rem;align-items:baseline;flex-wrap:wrap">
            <div>
              <div style="font-family:'Newsreader',Georgia,serif;font-size:1.5rem;font-weight:550">${esc2(c.name)}</div>
              <div class="dim mono" style="font-size:.8rem">${esc2(c.id)}</div>
            </div>
            <a class="rv-ghost" href="/model/${esc2(c.id)}">Full detail →</a>
          </div>
          ${c.multi && save > 0.001 ? `<div style="margin:.8rem 0">Spreads from <b class="cmp-cheap">${money(cheapest)}</b> to ${money(dearest)} per M — <span class="cmp-save">save up to ${money(save)}/M (${savePct}%)</span></div>` : ''}
          <div class="table-wrap" style="margin-top:.8rem">
            <table>
              <thead><tr><th>Source</th><th>In / M</th><th>Out / M</th><th>Blended</th><th>Context</th><th>Notes</th></tr></thead>
              <tbody>
                ${rows.map((s) => {
                  const b = s.input + s.output;
                  const cheap = b === cheapest && c.multi;
                  return `<tr>
                    <td style="${cheap ? 'color:var(--accent);font-weight:700' : ''}">${esc2(s.provider)}</td>
                    <td class="num">${money(s.input)}</td>
                    <td class="num">${money(s.output)}</td>
                    <td class="num" style="${cheap ? 'font-weight:700' : ''}">${money(b)}</td>
                    <td class="num">${s.ctx ? esc2(s.ctx) + 'k' : '—'}</td>
                    <td class="dim" style="font-size:.75rem">${esc2(s.note)}</td>
                  </tr>`;
                }).join('')}
              </tbody>
            </table>
          </div>
          ${!c.multi ? '<p class="dim" style="font-size:.8rem;margin:.7rem 0 0">Only OpenRouter sells this one right now — no direct-provider listing found.</p>' : ''}
        </div>`;
    }

    list.addEventListener('click', (e) => {
      const item = e.target.closest('.cmp-item');
      if (!item) return;
      selected = ALL.find((c) => c.id === item.dataset.id);
      renderList(); renderDetail(selected);
    });
    q.addEventListener('input', renderList);

    // default select: biggest spread
    if (DATA.multi.length) { selected = DATA.multi[0]; }
    renderList(); renderDetail(selected);
  </script>
</Base>
